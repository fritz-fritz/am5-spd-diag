#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	true

override_dh_auto_test:
	$(MAKE) test-tool

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/am5-spd-diag PREFIX=/usr install

override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade
