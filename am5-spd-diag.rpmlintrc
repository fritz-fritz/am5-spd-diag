# Passwordless snapshot/probe for a local active session is intentional.
# Factory polkit-default-privs / rules whitelist do not apply to a home project.
# .rpmlintrc uses addFilter() (not TOML Filters); OBS rpmlint 2.9 loads this file.
addFilter("polkit-user-privilege")
addFilter("polkit-untracked-privilege")
addFilter("polkit-file-unauthorized")
