# Passwordless snapshot/probe for a local active session is intentional.
# Factory lists these polkit checks in BlockedFilters, so a name filter
# never matches and is reported unused on the src package. Zero the
# badness instead: a home project cannot whitelist Factory polkit profiles.
# Leap/Fedora still score these unless badness is cleared.
setBadness("polkit-user-privilege", 0)
setBadness("polkit-untracked-privilege", 0)
setBadness("polkit-file-unauthorized", 0)
