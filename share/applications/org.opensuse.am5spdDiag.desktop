[Desktop Entry]
Type=Application
Name=Ghost DIMM
Comment=Check memory identity after sleep on AMD AM5
Exec=@LIBEXEC@/am5-spd-diag-notify --status
TryExec=@LIBEXEC@/am5-spd-diag-notify
Icon=org.opensuse.am5spdDiag
Terminal=false
StartupNotify=true
Categories=System;Monitor;
Keywords=AMD;AM5;DDR5;SPD;DIMM;memory;AGESA;
DBusActivatable=true
X-GNOME-UsesNotifications=true
Actions=analyze;report;

[Desktop Action analyze]
Name=Analyze
Exec=@LIBEXEC@/am5-spd-diag-notify --analyze

[Desktop Action report]
Name=Report
Exec=@LIBEXEC@/am5-spd-diag-notify --report
