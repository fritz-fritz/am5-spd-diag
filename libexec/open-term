#!/bin/bash
# Open a terminal on status, analyze, or report from a notification action.
set -u

self_path() {
  local src="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    readlink -f "$src" 2>/dev/null && return 0
  fi
  python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$src"
}

page_text() {
  if command -v less >/dev/null 2>&1; then
    less -R
  elif command -v more >/dev/null 2>&1; then
    more
  else
    cat
    echo
    read -r -p "Press Enter to close..."
  fi
}

page_markdown() {
  local file="$1"
  if command -v glow >/dev/null 2>&1; then
    glow -p "$file"
    return
  fi
  if command -v mdcat >/dev/null 2>&1; then
    mdcat --paginate "$file"
    return
  fi
  if command -v bat >/dev/null 2>&1; then
    bat --paging=always --style=plain --language=markdown "$file"
    return
  fi
  if python3 -c 'import rich.markdown' >/dev/null 2>&1; then
    python3 - "$file" <<'PY'
import os
import sys
from pathlib import Path

from rich.console import Console
from rich.markdown import Markdown

os.environ.setdefault("PAGER", "less -R")
text = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
console = Console(force_terminal=True)
with console.pager(styles=True):
    console.print(Markdown(text))
PY
    return
  fi
  if command -v less >/dev/null 2>&1; then
    less -R "$file"
    return
  fi
  cat "$file"
  echo
  read -r -p "Press Enter to close..."
}

run_action() {
  local action="$1"
  if [[ "$action" == report ]]; then
    local path
    path="$(am5-spd-diag report)" || true
    path="${path##*$'\n'}"
    if [[ -n "$path" && -f "$path" ]]; then
      page_markdown "$path"
      return 0
    fi
    echo "am5-spd-diag report did not write a markdown file."
    echo
    read -r -p "Press Enter to close..."
    return 1
  fi
  am5-spd-diag "$action" | page_text
}

# Run the GUI terminal inside the systemd user session so it inherits
# DISPLAY/WAYLAND_DISPLAY even when capture started us from a system unit.
# Forward XDG_ACTIVATION_TOKEN: systemd-run --user does not copy caller env.
start_gui() {
  local -a wrap=()
  if command -v systemd-run >/dev/null 2>&1 && [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    wrap=(systemd-run --user --collect --quiet)
    if [[ -n "${XDG_ACTIVATION_TOKEN:-}" ]]; then
      wrap+=(--setenv="XDG_ACTIVATION_TOKEN=${XDG_ACTIVATION_TOKEN}")
      wrap+=(--setenv="DESKTOP_STARTUP_ID=${XDG_ACTIVATION_TOKEN}")
    fi
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      wrap+=(--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY}")
    fi
    if [[ -n "${DISPLAY:-}" ]]; then
      wrap+=(--setenv="DISPLAY=${DISPLAY}")
    fi
    if [[ -n "${XAUTHORITY:-}" ]]; then
      wrap+=(--setenv="XAUTHORITY=${XAUTHORITY}")
    fi
    wrap+=(-- )
    if "${wrap[@]}" "$@"; then
      exit 0
    fi
  fi
  "$@" &
  exit 0
}

open_terminal() {
  local self="$1" action="$2"
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    start_gui xdg-terminal-exec -- "$self" --run "$action"
  fi
  if command -v konsole >/dev/null 2>&1; then
    start_gui konsole -e "$self" --run "$action"
  fi
  if command -v kgx >/dev/null 2>&1; then
    start_gui kgx -- "$self" --run "$action"
  fi
  if command -v gnome-terminal >/dev/null 2>&1; then
    start_gui gnome-terminal -- "$self" --run "$action"
  fi
  if command -v mate-terminal >/dev/null 2>&1; then
    start_gui mate-terminal -- "$self" --run "$action"
  fi
  if command -v xfce4-terminal >/dev/null 2>&1; then
    start_gui xfce4-terminal -e "$self --run $action"
  fi
  if command -v lxterminal >/dev/null 2>&1; then
    start_gui lxterminal -e "$self" --run "$action"
  fi
  if command -v kitty >/dev/null 2>&1; then
    start_gui kitty "$self" --run "$action"
  fi
  if command -v alacritty >/dev/null 2>&1; then
    start_gui alacritty -e "$self" --run "$action"
  fi
  if command -v foot >/dev/null 2>&1; then
    start_gui foot "$self" --run "$action"
  fi
  if command -v xterm >/dev/null 2>&1; then
    start_gui xterm -e "$self" --run "$action"
  fi
  exec "$self" --run "$action"
}

SELF="$(self_path)"
if [[ "${1:-}" == --run ]]; then
  ACTION="${2:-status}"
  case "$ACTION" in
    status|analyze|report) ;;
    *) ACTION=status ;;
  esac
  run_action "$ACTION"
  exit $?
fi

ACTION="${1:-status}"
case "$ACTION" in
  status|analyze|report) ;;
  *) ACTION=status ;;
esac
open_terminal "$SELF" "$ACTION"
