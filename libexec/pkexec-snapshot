#!/bin/bash
# Polkit-scoped helper: capture one manual SPD/DIMM snapshot. Nothing else.
set -eu
if [[ $# -ne 0 ]]; then
  echo "am5-spd-diag snapshot helper accepts no arguments" >&2
  exit 2
fi
export PATH="/usr/sbin:/sbin:/usr/bin:/bin"
unset PYTHONPATH PYTHONHOME PYTHONUSERBASE
unset LD_PRELOAD LD_LIBRARY_PATH
# Ignore caller-controlled paths; pin share from this helper's location.
unset AM5_SPD_DIAG_STATE_DIR AM5_SPD_DIAG_LIBEXEC AM5_SPD_DIAG_SHARE AM5_SPD_DIAG_PREFIX
HERE="$(cd "$(dirname "$0")" && pwd)"
case "$HERE" in
  /usr/libexec/am5-spd-diag)
    export AM5_SPD_DIAG_SHARE=/usr/share/am5-spd-diag
    export AM5_SPD_DIAG_LIBEXEC=/usr/libexec/am5-spd-diag
    ;;
  /usr/local/libexec/am5-spd-diag)
    export AM5_SPD_DIAG_SHARE=/usr/local/share/am5-spd-diag
    export AM5_SPD_DIAG_LIBEXEC=/usr/local/libexec/am5-spd-diag
    ;;
  *)
    export AM5_SPD_DIAG_SHARE="$(cd "$HERE/.." && pwd)"
    export AM5_SPD_DIAG_LIBEXEC="$HERE"
    ;;
esac
exec /bin/bash "$HERE/capture.sh" manual
