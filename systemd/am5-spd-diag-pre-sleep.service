[Unit]
Description=Capture AM5 DIMM/SPD evidence before system sleep
Documentation=file:///usr/share/doc/am5-spd-diag/README.md
DefaultDependencies=no
Before=sleep.target
RequiresMountsFor=/var/log

[Service]
Type=oneshot
ExecStart=-/usr/bin/am5-spd-diag capture pre
TimeoutStartSec=30

[Install]
WantedBy=sleep.target
